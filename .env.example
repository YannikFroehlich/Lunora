# Django
# Use a unique secret in real deployments. Keep the real value only in .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LANGUAGE_CODE=de-de
DJANGO_TIME_ZONE=Europe/Berlin

# Weather
# Optional. Without a key, Lunora shows demo weather data and a radar preview.
OPENWEATHER_API_KEY=
# WEATHER_API_KEY is also accepted as a fallback alias.
# WEATHER_API_KEY=
WEATHER_DEFAULT_CITY=Buende,de

# Optional OpenWeather endpoint overrides.
OPENWEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_GEO_API_BASE_URL=https://api.openweathermap.org/geo/1.0
OPENWEATHER_TILE_BASE_URL=https://tile.openweathermap.org/map
