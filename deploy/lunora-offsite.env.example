# Copy to /etc/lunora/offsite.env, owner root:root, mode 0600. The lunora group must not read it.

# Pick one target. restic creates nothing by itself: run "restic init" once (see DEPLOYMENT.md).
RESTIC_REPOSITORY=sftp:backup@backup-host.example:/srv/backups/lunora
# RESTIC_REPOSITORY=s3:s3.eu-central-003.backblazeb2.com/lunora-backup
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# openssl rand -hex 32
# Keep a copy off this server. Without this password the backup cannot be read by anyone.
RESTIC_PASSWORD=

# Optional dead man's switch, called after every successful run. The monitor alerts when the
# call stops arriving, so it also catches a dead server.
OFFSITE_PING_URL=
