[Unit]
Description=Cloudflare Tunnel for lunora.yfserver.de
After=network-online.target
Wants=network-online.target
# The remotely managed tunnel token lives only in this root-owned 0600 file, never in the unit.
ConditionPathExists=/etc/cloudflared/token

[Service]
Type=notify
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
