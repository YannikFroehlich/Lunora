[Unit]
Description=Deploy new Lunora main commits
After=network-online.target postgresql.service redis-server.service nginx.service
Wants=network-online.target
ConditionPathIsDirectory=/srv/lunora/app/.git

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/lunora-auto-deploy
TimeoutStartSec=30min
UMask=0027
StateDirectory=lunora-auto-deploy
StateDirectoryMode=0750
RuntimeDirectory=lunora-auto-deploy
RuntimeDirectoryMode=0750

PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/srv/lunora/app /srv/lunora/venv
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
