[Unit]
Description=Create a local Lunora PostgreSQL and upload backup
After=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/lunora/lunora.env
ExecStart=/usr/local/sbin/lunora-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/lunora/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
