# Copy to /etc/lunora/lunora.env, replace every change-me value, then set
# owner root:lunora and mode 0640. Never commit the populated file.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=lunora.yfserver.de
DJANGO_CSRF_TRUSTED_ORIGINS=https://lunora.yfserver.de
DJANGO_LANGUAGE_CODE=de-de
DJANGO_TIME_ZONE=Europe/Berlin
DJANGO_STATIC_ROOT=staticfiles
DJANGO_PRIVATE_MEDIA_ROOT=private_media

DJANGO_DATABASE_ENGINE=postgresql
DJANGO_DB_NAME=lunora
DJANGO_DB_USER=lunora
DJANGO_DB_PASSWORD=change-me
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_CONNECT_TIMEOUT=10
DJANGO_DB_SSLMODE=

DJANGO_CACHE_URL=redis://127.0.0.1:6379/1

DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_CSRF_COOKIE_HTTPONLY=false
DJANGO_USE_X_FORWARDED_PROTO=true
DJANGO_USE_X_FORWARDED_HOST=true

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.strato.de
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_HOST_USER=webmaster@yfserver.de
DJANGO_EMAIL_HOST_PASSWORD=change-me
DJANGO_EMAIL_USE_TLS=false
DJANGO_EMAIL_USE_SSL=true
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL="Lunora <webmaster@yfserver.de>"
DJANGO_SERVER_EMAIL="Lunora <webmaster@yfserver.de>"
DJANGO_ADMINS=Yannik:webmaster@yfserver.de

CLOUDFLARE_TURNSTILE_REQUIRED=true
CLOUDFLARE_TURNSTILE_SITE_KEY=change-me
CLOUDFLARE_TURNSTILE_SECRET_KEY=change-me
CLOUDFLARE_TURNSTILE_EXPECTED_HOSTNAME=lunora.yfserver.de
CLOUDFLARE_TURNSTILE_TIMEOUT=5

LUNORA_AUTOMATION_INTERVAL_SECONDS=60
LUNORA_WEEKLY_SUMMARY_HOUR=8

WEB_PUSH_VAPID_PUBLIC_KEY=change-me
WEB_PUSH_VAPID_PRIVATE_KEY=/etc/lunora/vapid_private.pem
WEB_PUSH_VAPID_SUBJECT=mailto:webmaster@yfserver.de
WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,notify.windows.com,push.apple.com
WEB_PUSH_TTL_SECONDS=600
WEB_PUSH_TIMEOUT_SECONDS=10
WEB_PUSH_MAX_ATTEMPTS=5

OPENWEATHER_API_KEY=
WEATHER_DEFAULT_CITY=Buende,de
WEATHER_CACHE_SECONDS=600
