[Unit]
Description=Copy the Lunora backup to an encrypted off-site restic repository
Wants=network-online.target
After=network-online.target lunora-backup.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/lunora/offsite.env
Environment=RESTIC_CACHE_DIR=/var/cache/lunora-offsite
CacheDirectory=lunora-offsite
ExecStart=/usr/local/sbin/lunora-offsite-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

PrivateTmp=true
# read-only, not true: an sftp repository needs root's SSH key and known_hosts.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/srv/lunora/backups
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
